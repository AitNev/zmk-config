// Left half only: the nice!nano's P0.02 (pro_micro 19, ROW0) and P1.15 (pro_micro 18, ROW1)
// stopped reading. Both rows are rewired with jumper wires on the board:
//   ROW0 (PCB "F6/ROW0", chip 002) -> PCB "D2"     pad, chip 008 = pro_micro 0
//   ROW1 (PCB "F7/ROW1", chip 115) -> PCB "D1/SDA" pad, chip 017 = pro_micro 2
// RGB data (D3, pro_micro 1) is left untouched.

&kscan0 {
    row-gpios
        = <&pro_micro 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW0 (was pro_micro 19)
        , <&pro_micro 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW1 (was pro_micro 18)
        , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
};

// SDA is now a matrix row, so the I2C bus (OLED / trackball) can't be used on this half.
&pro_micro_i2c {
    status = "disabled";
};

/ {
    chosen {
        /delete-property/ zephyr,display;
    };
};
